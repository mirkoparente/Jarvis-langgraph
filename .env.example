# Copia questo file in .env e modifica i valori. Tutte le variabili sono facoltative.

# Indirizzo di Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Modello per orchestratore e agenti (deve supportare il tool calling)
JARVIS_MODELLO=qwen3:8b

# Modello di embedding per il RAG
JARVIS_MODELLO_EMBEDDING=nomic-embed-text

# Cartella con le note .md da indicizzare (es. un vault Obsidian). Default: ./note
# Su Windows scrivi il percorso SENZA virgolette doppie: dentro "..." i \ vengono interpretati come escape
JARVIS_CARTELLA_NOTE=C:\percorso\del\tuo\vault

# Webhook n8n del classificatore di messaggi (URL di produzione, workflow pubblicato).
# Il workflow n8n è in https://github.com/mirkoparente/n8n_classificatore
JARVIS_N8N_WEBHOOK_URL=http://localhost:5678/webhook/chiedi
